# Every config key Design Intern reads. Store them in Infisical Secrets Manager (the
# Makefile runs everything under `infisical run`); don't copy this to a .env file.
# Agent credentials are placeholders like __linear_api_key__: set them on the host
# to switch a source on, and the sandbox's Agent Vault proxy swaps in the real value.

# Host credentials: real values. The sandbox never sees them.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
AGENT_VAULT_CA_FINGERPRINT=SHA256:...
# Slack bot (Socket Mode). Scopes: app_mentions:read, chat:write, im:history,
# channels:history, groups:history, channels:read, users:read, users:read.email
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Sandbox
AGENT_VAULT_ACCESS_BUNDLE=design-intern
# Modal Secret holding INFISICAL_AGENT_VAULT_PROXY_TOKEN, given to the proxy sidecar only.
AGENT_VAULT_PROXY_SECRET=design-intern-proxy
# MODAL_APP_NAME=design-intern
# MODAL_ENVIRONMENT=
# RUN_TIMEOUT_MS=900000
# INFISICAL_DOMAIN=https://app.infisical.com

# Who may use the bot and approve drafts.
DESIGN_ALLOWLIST=you@infisical.com

# Sources. Each list is the scope boundary for that source.
LINEAR_API_KEY=__linear_api_key__
# Issues assigned to these people (comma-separated), and/or in these teams. Both set = both must match.
LINEAR_ASSIGNEE_EMAILS=jadden@infisical.com
LINEAR_TEAM_KEYS=
GITHUB_TOKEN=__github_token__
GITHUB_REPOS=Infisical/infisical
DESIGN_GITHUB_LOGINS=
DESIGN_SLACK_CHANNELS=
FIGMA_API_KEY=__figma_api_key__
FIGMA_FILE_KEYS=
# Figma "folders" are projects: every file in these projects is authorized.
# The id is the number in figma.com/files/team/<team>/folder/<id> (older URLs: /project/<id>). PAT needs projects:read.
FIGMA_PROJECT_IDS=

# Approval flow. Drafts preview in the approval channel; approved updates post to
# the update channel. Unset update channel = approvals are dry runs.
DESIGN_APPROVAL_CHANNEL=
DESIGN_UPDATE_CHANNEL=
WEEKLY_DRAFT_AT=fri 10:00
WEEKLY_DRAFT_TZ=America/Los_Angeles

# Web inbox (off unless a password is set). Basic auth: any name + this password.
WEB_ACCESS_PASSWORD=
WEB_BASE_URL=

# Optional
# UPDATE_TEMPLATE=templates/weekly-update.md
# AGENT_NAME=Design Intern
# DRAFT_MODEL=claude-opus-5-5
# CHAT_MODEL=claude-sonnet-5-5
# REFERENCE_MODEL=claude-haiku-5-5
# DATA_DIR=data
