{
  "name": "agent-template",
  "version": "0.1.0",
  "description": "Boilerplate for building Claude Agent SDK agents that run behind Infisical's agent-vault proxy",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:slack": "tsx --watch src/slack.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.101",
    "@slack/bolt": "^4.7.0",
    "dotenv": "^17.4.1",
    "https-proxy-agent": "^9.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "license": "MIT"
}
